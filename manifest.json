{
  "manifest_version": 3,
  "name": "Synology Photos – Kartenansicht",
  "version": "0.2.4",
  "description": "Ergänzt die Weboberfläche von Synology Photos um eine Kartenansicht für Fotos mit GPS-Daten.",
  "minimum_chrome_version": "111",
  "permissions": ["scripting", "activeTab", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Synology Photos – Kartenansicht",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["map.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
